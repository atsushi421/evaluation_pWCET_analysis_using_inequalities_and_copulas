{
 "_comment": "Instrumentation targets of the Autoware campaign (notes/autoware_campaign_design.md in the paper repo, sec. 4). One entry per source file; files of the same process must have disjoint id ranges (id_base). 'job' marks the callback whose invocations are recorded as runs; 'functions' are the callees instrumented as function units (Class::method); 'bounds' gives static loop bounds by unit uid.",
 "workspace": "~/autoware",
 "processes": {
  "cb1": {
   "packages": [
    "autoware_ekf_localizer"
   ],
   "pgrep": "autoware_ekf_localizer_node",
   "cores": [
    6
   ]
  },
  "cb2": {
   "packages": [
    "autoware_twist2accel"
   ],
   "pgrep": "autoware_twist2accel_node",
   "cores": [
    6
   ],
   "_note": "shares core 6 with cb1: cb1 -> cb3 -> cb2 form a sequential data flow (each runs when the previous one has published), so they never contend for the core; both are ~100 us at 50 Hz"
  },
  "cb3": {
   "packages": [
    "autoware_stop_filter"
   ],
   "pgrep": "autoware_stop_filter_node",
   "cores": [
    6
   ],
   "_note": "shares core 6 with cb1: cb1 -> cb3 -> cb2 form a sequential data flow (each runs when the previous one has published), so they never contend for the core; both are ~100 us at 50 Hz"
  },
  "cb4": {
   "packages": [
    "autoware_trajectory_follower_node",
    "autoware_mpc_lateral_controller",
    "autoware_pid_longitudinal_controller"
   ],
   "pgrep": "__node:=trajectory_follower_container",
   "cores": [
    8
   ]
  },
  "cb5": {
   "packages": [
    "autoware_ground_segmentation"
   ],
   "pgrep": "__node:=pointcloud_container -r __ns:=/",
   "cores": [
    12,
    13,
    14,
    15
   ],
   "pin_after_init": true,
   "_note": "pointcloud_container: pinned to the NON-isolated cores 12-15 once the localization initialized (multi-core pinning onto isolcpus cores does not spread the threads: isolated CPUs have no load balancing, verified with 4 busy tasks piling on one core). During start-up and initialization it uses every non-isolated core. The runner confines the rest of the stack and the desktop away from 12-15; only root jobs can wander in, which the foreign sampler reports separately."
  },
  "cb6": {
   "packages": [
    "autoware_lane_departure_checker"
   ],
   "pgrep": "__node:=control_check_container",
   "cores": [
    9
   ]
  },
  "cb7": {
   "packages": [
    "autoware_ndt_scan_matcher"
   ],
   "pgrep": "autoware_ndt_scan_matcher_node",
   "cores": [
    7
   ],
   "pin_after_init": false,
   "_note": "NDT: on its own isolated core 7 once the localization initialized (single core -> no balancing needed; the whole process time-shares it, num_threads stays 4). During initialization it runs unpinned on the non-isolated cores; pinning it to a set of isolated cores made the particle search pile on one core and never finish (smoke #9).",
   "init_cores": []
  }
 },
 "packages": {
  "autoware_ekf_localizer": {
